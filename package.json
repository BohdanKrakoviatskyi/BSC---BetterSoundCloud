{
  "name": "better-soundcloud",
  "version": "0.1.1",
  "private": true,
  "description": "Локальный улучшенный клиент SoundCloud",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "backend": "node scripts/backend-console.mjs",
    "test:go": "cd backend && go test ./...",
    "test:go:live": "node scripts/test-backend-live.mjs",
    "build:go": "node scripts/build-go.mjs",
    "build:frontend": "tsc --noEmit && vite build",
    "vite": "vite",
    "prepare:dev": "npm run build:go && npm run vite",
    "build": "npm run build:frontend",
    "package": "npm run build:go && tauri build",
    "package:mac": "npm run build:go && tauri build --bundles app,dmg",
    "package:win": "npm run build:go && tauri build --bundles nsis,msi"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "hls.js": "^1.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.12"
  }
}
