{
  "name": "better-soundcloud",
  "version": "0.2.0",
  "private": true,
  "description": "Локальный десктопный клиент для SoundCloud, Spotify и YouTube Music",
  "scripts": {
    "dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "backend": "node scripts/backend-console.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:go": "cd backend && go test ./...",
    "test:go:live": "node scripts/test-backend-live.mjs",
    "test:lyrics": "node scripts/lyrics-coverage.mjs",
    "build:go": "node scripts/build-go.mjs",
    "fetch:ytdlp": "node scripts/fetch-ytdlp.mjs",
    "build:frontend": "tsc --noEmit && vite build",
    "vite": "vite",
    "prepare:dev": "npm run fetch:ytdlp && npm run build:go && npm run vite",
    "build": "npm run build:frontend",
    "package": "npm run fetch:ytdlp && npm run build:go && tauri build",
    "package:mac": "npm run fetch:ytdlp && npm run build:go && tauri build --bundles app,dmg",
    "package:win": "npm run fetch:ytdlp && npm run build:go && tauri build --bundles nsis,msi",
    "release": "node scripts/trigger-release.mjs",
    "test:node": "node scripts/run-node-tests.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "hls.js": "^1.7.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.12"
  }
}
