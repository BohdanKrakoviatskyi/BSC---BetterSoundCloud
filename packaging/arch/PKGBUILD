# Builds the checkout this file sits in: run `makepkg -si` from this folder.
pkgname=resonance
pkgver=0.2.6
pkgrel=1
pkgdesc='A Spotify player for Wayland, in Material 3 after end4'
arch=('x86_64' 'aarch64')
license=('custom')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-svg'
         'qtkeychain-qt6' 'qcoro' 'libsecret' 'libpulse'
         'alsa-lib' 'openssl' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'rust' 'qt6-shadertools' 'git' 'clang')
optdepends=('xdg-desktop-portal: the native file picker for cover photos'
            'ttf-material-symbols-variable-git: the icon font, if not bundled at build time')
options=('!lto')

_root="$startdir/../.."

build() {
    # clang, not the default gcc: gcc miscompiles the qcoro coroutines
    cmake -S "$_root" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    # the bundled colour library is apache-2.0
    install -Dm644 "$_root/third_party/material-color-utilities/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/material-color-utilities.LICENSE"
}
