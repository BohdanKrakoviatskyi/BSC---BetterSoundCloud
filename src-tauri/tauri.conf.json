{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BetterSoundCloud",
  "version": "0.1.7",
  "identifier": "com.bettersoundcloud.app",
  "build": {
    "beforeDevCommand": "npm run prepare:dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "BetterSoundCloud",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' https://w.soundcloud.com; frame-src https://w.soundcloud.com; media-src 'self' blob: https://*.sndcdn.com https://*.soundcloud.cloud; worker-src 'self' blob:; img-src 'self' asset: data: https://*.sndcdn.com https://*.soundcloud.com https://images.unsplash.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:5173 https://*.sndcdn.com https://*.soundcloud.cloud"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "externalBin": ["binaries/local-api"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVENkU0QUJCRjIzMkQ1N0MKUldSODFUTHl1MHB1N2F1L1B4N2ZIUjNEenFjMDk2MCtjNG9pcFNOazN5eUlkN1o0S0VPZzd1K1cK",
      "endpoints": [
        "https://github.com/BohdanKrakoviatskyi/BSC---BetterSoundCloud/releases/latest/download/latest.json"
      ]
    }
  }
}
