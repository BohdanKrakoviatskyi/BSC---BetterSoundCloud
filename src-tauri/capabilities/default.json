{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main application window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "allow-start-soundcloud-login",
    "allow-start-ytmusic-login",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "binaries/local-api", "sidecar": true, "args": false },
        { "name": "binaries/ytmusic-worker", "sidecar": true, "args": false }
      ]
    },
    "shell:allow-open",
    "shell:allow-stdin-write"
  ]
}
