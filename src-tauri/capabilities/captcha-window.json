{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "captcha-window",
  "description": "Allows the DataDome captcha webview to signal a successful verification check.",
  "local": false,
  "windows": ["soundcloud-captcha"],
  "remote": {
    "urls": ["https://geo.captcha-delivery.com", "https://*.captcha-delivery.com", "https://soundcloud.com", "https://*.soundcloud.com"]
  },
  "permissions": ["allow-mark-captcha-completed", "allow-save-captcha-user-agent", "allow-mark-captcha-unavailable"]
}
