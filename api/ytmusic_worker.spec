# PyInstaller one-file console sidecar. Build only on the target OS/architecture.
from PyInstaller.utils.hooks import collect_all


datas, binaries, hiddenimports = collect_all("ytmusicapi")

a = Analysis(
    ["ytmusic_worker.py"],
    pathex=["."],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
)
pyz = PYZ(a.pure)
exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="ytmusic-worker",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,
    console=True,
    disable_windowed_traceback=False,
)
